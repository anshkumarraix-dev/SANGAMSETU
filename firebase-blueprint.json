{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile linking Firebase Auth to role-based access control.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "role": {
          "type": "string",
          "enum": ["startup", "government", "testing_org", "admin"],
          "description": "Platform role determining access permissions"
        },
        "organizationName": {
          "type": "string",
          "maxLength": 100,
          "description": "Name of the startup, department, or testing org"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp of creation"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp of last update"
        },
        "isApproved": {
          "type": "boolean",
          "description": "Whether the admin has approved this account"
        }
      },
      "required": ["email", "role", "organizationName", "createdAt", "updatedAt", "isApproved"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles and their RBAC roles."
    }
  }
}
